{
  "version": "2.10",
  "children": [
    {
      "type": "frame",
      "id": "page_shop_item_create",
      "x": 0,
      "y": 0,
      "name": "Shop Item Create",
      "width": 1280,
      "height": 800,
      "fill": "$color.bg.canvas",
      "layout": "vertical",
      "gap": "$space.4",
      "padding": "$space.6",
      "children": [
        {
          "type": "text",
          "id": "title_shop_item_create",
          "fill": "$color.text.primary",
          "content": "/shop/new -> src/pages/ShopNewPage.tsx",
          "fontFamily": "Inter",
          "fontSize": 24,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "desc_shop_item_create",
          "fill": "$color.text.muted",
          "content": "商品创建表单（名称、描述、单价、最小数量、单位）。",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "Xjf2o",
          "name": "header/shop-item-create",
          "width": "fill_container",
          "fill": "$color.bg.surface",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$color.border.subtle"
          },
          "padding": [
            "$space.3",
            "$space.4"
          ],
          "children": [
            {
              "type": "text",
              "id": "o5llO",
              "name": "text/header",
              "fill": "#334155",
              "content": "商品创建 · 面包屑与操作",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "eimRw",
          "name": "content/shop-item-create-main",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "gap": "$space.3",
          "padding": "$space.3",
          "children": [
            {
              "type": "frame",
              "id": "dMQvY",
              "name": "form/shop-item-form",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "$color.primary",
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "$color.border.subtle"
              },
              "layout": "vertical",
              "children": [
                {
                  "id": "nceRr",
                  "type": "ref",
                  "ref": "lVwKh",
                  "width": "fill_container",
                  "name": "secRefC1"
                }
              ]
            },
            {
              "type": "frame",
              "id": "cxkGq",
              "name": "detail/shop-item-preview",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "$color.primary",
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "$color.border.subtle"
              },
              "layout": "vertical",
              "children": [
                {
                  "id": "6R8Qj",
                  "type": "ref",
                  "ref": "lVwKh",
                  "width": "fill_container",
                  "name": "secRefC2"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "lVwKh",
      "x": 0,
      "y": 860,
      "name": "component/form-section",
      "reusable": true,
      "width": 360,
      "height": 120,
      "fill": "$color.bg.surface",
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "$color.border.subtle"
      },
      "layout": "vertical",
      "gap": "$space.2",
      "padding": "$space.3",
      "children": [
        {
          "type": "text",
          "id": "uoygU",
          "name": "secTitleC",
          "fill": "$color.primary",
          "content": "表单字段",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "500"
        },
        {
          "type": "text",
          "id": "G4WPF",
          "name": "secDescC",
          "fill": "$color.primary",
          "content": "名称、描述、单价、最小数量、单位",
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    }
  ],
  "variables": {
    "color.bg.canvas": {
      "type": "color",
      "value": "#F5F7FA"
    },
    "color.bg.muted": {
      "type": "color",
      "value": "#F1F5F9"
    },
    "color.bg.surface": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "color.border.soft": {
      "type": "color",
      "value": "#F1F5F9"
    },
    "color.border.subtle": {
      "type": "color",
      "value": "#E2E8F0"
    },
    "color.primary": {
      "type": "color",
      "value": "#2563EB"
    },
    "color.text.muted": {
      "type": "color",
      "value": "#64748B"
    },
    "color.text.primary": {
      "type": "color",
      "value": "#0F172A"
    },
    "space.1": {
      "type": "number",
      "value": 4
    },
    "space.2": {
      "type": "number",
      "value": 8
    },
    "space.3": {
      "type": "number",
      "value": 12
    },
    "space.4": {
      "type": "number",
      "value": 16
    },
    "space.6": {
      "type": "number",
      "value": 24
    }
  }
}