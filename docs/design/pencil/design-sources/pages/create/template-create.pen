{
  "version": "2.10",
  "children": [
    {
      "type": "frame",
      "id": "page_template_create",
      "x": 0,
      "y": 0,
      "name": "Template Create",
      "width": 1280,
      "height": 800,
      "fill": "$color.bg.canvas",
      "layout": "vertical",
      "gap": "$space.4",
      "padding": "$space.6",
      "children": [
        {
          "type": "text",
          "id": "title_template_create",
          "fill": "$color.text.primary",
          "content": "/templates/new -> src/pages/TemplatesNewPage.tsx",
          "fontFamily": "Inter",
          "fontSize": 24,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "desc_template_create",
          "fill": "$color.text.muted",
          "content": "积分模版创建表单（名称、描述、保存/取消）。",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "6JRsX",
          "name": "header/template-create",
          "width": "fill_container",
          "fill": "$color.bg.surface",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$color.border.subtle"
          },
          "padding": [
            "$space.3",
            "$space.4"
          ],
          "children": [
            {
              "type": "text",
              "id": "5mAuk",
              "name": "text/header",
              "fill": "#334155",
              "content": "模版创建 · 面包屑与操作",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "8VZz5",
          "name": "content/template-create-main",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "gap": "$space.3",
          "padding": "$space.3",
          "children": [
            {
              "type": "frame",
              "id": "tEDH3",
              "name": "form/template-form",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "$color.primary",
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "$color.border.subtle"
              },
              "layout": "vertical",
              "children": [
                {
                  "id": "9kLby",
                  "type": "ref",
                  "ref": "3qiUo",
                  "width": "fill_container",
                  "name": "secRefA"
                }
              ]
            },
            {
              "type": "frame",
              "id": "srbDc",
              "name": "detail/template-preview",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "$color.primary",
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "$color.border.subtle"
              },
              "layout": "vertical",
              "children": [
                {
                  "id": "s3ukk",
                  "type": "ref",
                  "ref": "3qiUo",
                  "width": "fill_container",
                  "name": "secRefB"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "3qiUo",
      "x": 0,
      "y": 860,
      "name": "component/form-section",
      "reusable": true,
      "width": 360,
      "height": 120,
      "fill": "$color.bg.surface",
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "$color.border.subtle"
      },
      "layout": "vertical",
      "gap": "$space.2",
      "padding": "$space.3",
      "children": [
        {
          "type": "text",
          "id": "Ro2hQ",
          "name": "secTitleA",
          "fill": "$color.primary",
          "content": "模版基础字段",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "500"
        },
        {
          "type": "text",
          "id": "1je49",
          "name": "secDescA",
          "fill": "$color.primary",
          "content": "名称、描述、启用状态",
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    }
  ],
  "variables": {
    "color.bg.canvas": {
      "type": "color",
      "value": "#F5F7FA"
    },
    "color.bg.muted": {
      "type": "color",
      "value": "#F1F5F9"
    },
    "color.bg.surface": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "color.border.soft": {
      "type": "color",
      "value": "#F1F5F9"
    },
