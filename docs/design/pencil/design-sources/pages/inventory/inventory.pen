{
  "version": "2.10",
  "children": [
    {
      "type": "frame",
      "id": "page_inventory",
      "x": 0,
      "y": 0,
      "name": "Inventory",
      "width": 1280,
      "height": 800,
      "fill": "$color.bg.canvas",
      "layout": "vertical",
      "gap": "$space.4",
      "padding": "$space.6",
      "children": [
        {
          "type": "text",
          "id": "title_inventory",
          "fill": "$color.text.primary",
          "content": "/inventory -> src/components/Inventory.tsx",
          "fontFamily": "Inter",
          "fontSize": 24,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "desc_inventory",
          "fill": "$color.text.muted",
          "content": "背包列表页，承接兑换记录查看。",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "Hhswm",
          "name": "header/inventory",
          "width": "fill_container",
          "fill": "$color.bg.surface",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$color.border.subtle"
          },
          "padding": [
            "$space.3",
            "$space.4"
          ],
          "children": [
            {
              "type": "text",
              "id": "S9ZEG",
              "name": "text/header",
              "fill": "#334155",
              "content": "背包筛选与统计",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "z7n30",
          "name": "content/inventory-main",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "gap": "$space.3",
          "padding": "$space.3",
          "children": [
            {
              "type": "frame",
              "id": "PmP3l",
              "name": "list/inventory-list",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "$color.primary",
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "$color.border.subtle"
              },
              "layout": "vertical",
              "children": [
                {
                  "id": "lUgLd",
                  "type": "ref",
                  "ref": "sPZHh",
                  "width": "fill_container",
                  "name": "itemRefI1"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Nhhrj",
              "name": "detail/inventory-detail",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "$color.primary",
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "$color.border.subtle"
              },
              "layout": "vertical",
              "children": [
                {
                  "id": "nfIvH",
                  "type": "ref",
                  "ref": "sPZHh",
                  "width": "fill_container",
                  "name": "itemRefI2"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "sPZHh",
      "x": 0,
      "y": 860,
      "name": "component/inventory-item",
      "reusable": true,
      "width": 360,
      "height": 130,
      "fill": "$color.bg.surface",
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "$color.border.subtle"
      },
      "layout": "vertical",
      "gap": "$space.2",
      "padding": "$space.3",
      "children": [
        {
          "type": "text",
          "id": "FMUlJ",
          "name": "itemNameI",
          "fill": "$color.primary",
          "content": "自定义主题券",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "500"
        },
        {
          "type": "text",
          "id": "nkWQB",
          "name": "itemMetaI",
          "fill": "$color.primary",
          "content": "库存 1 · 最近使用 2026-04-09",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    }
  ],
  "variables": {
    "color.bg.canvas": {
      "type": "color",
      "value": "#F5F7FA"
    },
    "color.bg.muted": {
      "type": "color",
      "value": "#F1F5F9"
    },
    "color.bg.surface": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "color.border.soft": {
      "type": "color",
      "value": "#F1F5F9"
    },
    "color.border.subtle": {
      "type": "color",
      "value": "#E2E8F0"
    },
    "color.primary": {
      "type": "color",
      "value": "#2563EB"
    },
    "color.text.muted": {
      "type": "color",
      "value": "#64748B"
    },
    "color.text.primary": {
      "type": "color",
      "value": "#0F172A"
    },
    "space.1": {
      "type": "number",
      "value": 4
    },
    "space.2": {
      "type": "number",
      "value": 8
    },
    "space.3": {
      "type": "number",
      "value": 12
    },
    "space.4": {
      "type": "number",
      "value": 16
    },
    "space.6": {
      "type": "number",
      "value": 24
    }
  }
}