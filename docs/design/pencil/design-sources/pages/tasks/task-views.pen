              "fill": "#FFFFFF",
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "#E2E8F0"
              },
              "layout": "vertical",
              "gap": "\\$page.space.tight",
              "padding": 12,
              "children": [
                {
                  "type": "text",
                  "id": "wcYMl",
                  "name": "text/detail",
                  "fill": "#0F172A",
                  "content": "detail / editor / preview",
                  "fontFamily": "\\$page.font",
                  "fontSize": 13,
                  "fontWeight": "500"
                },
                {
                  "id": "9yPlU",
                  "type": "ref",
                  "ref": "nssYi",
                  "width": "fill_container",
                  "name": "inst3",
                  "fill": "#FFFFFF",
                  "gap": "\\$page.space.tight",
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#E2E8F0"
                  },
                  "descendants": {
                    "CZKlZ": {
                      "fontFamily": "\\$page.font",
                      "fill": "#0F172A"
                    },
                    "c5q9U": {
                      "fontFamily": "\\$page.font",
                      "fill": "#0F172A"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "nssYi",
      "x": 0,
      "y": 860,
      "name": "component/task-info-card",
      "reusable": true,
      "width": 360,
      "fill": "$color.bg.surface",
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "$color.border.subtle"
      },
      "layout": "vertical",
      "gap": "$space.2",
      "padding": "$space.3",
      "children": [
        {
          "type": "text",
          "id": "CZKlZ",
          "name": "cardTitle",
          "fill": "$color.primary",
          "content": "晨读英语 30 分钟",
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "c5q9U",
          "name": "cardMeta",
          "fill": "$color.primary",
          "content": "状态：进行中 · 目标奖励：20 分",
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "xIA8W",
      "x": 380,
      "y": 860,
      "name": "component/task-list-row",
      "reusable": true,
      "width": 360,
      "fill": "$color.bg.surface",
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "$color.border.subtle"
      },
      "padding": [
        "$space.2",
        "$space.3"
      ],
      "justifyContent": "space_between",
      "alignItems": "center",
      "children": [
        {
          "type": "text",
          "id": "O1GTG",
          "name": "rowText",
          "fill": "$color.primary",
          "content": "模板：番茄学习 25/5",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "1TUp0",
          "name": "rowState",
          "fill": "#16A34A",
          "content": "已启用",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        }
      ]
    }
  ],
  "variables": {
    "color.bg.canvas": {
      "type": "color",
      "value": "#F5F7FA"
    },
    "color.bg.muted": {
      "type": "color",
      "value": "#F1F5F9"
    },
    "color.bg.surface": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "color.border.soft": {
      "type": "color",
      "value": "#F1F5F9"
    },
    "color.border.subtle": {
      "type": "color",
      "value": "#E2E8F0"
    },
    "color.primary": {
      "type": "color",
      "value": "#2563EB"
    },
    "color.text.muted": {
      "type": "color",
      "value": "#64748B"
    },
    "color.text.primary": {
      "type": "color",
      "value": "#0F172A"
    },
    "space.1": {
      "type": "number",
      "value": 4
    },
    "space.2": {
      "type": "number",
      "value": 8
    },
    "space.3": {
      "type": "number",
      "value": 12
    },
    "space.4": {
      "type": "number",
      "value": 16
    },
    "space.6": {
      "type": "number",
      "value": 24
    },
    "page.bg": {
      "type": "color",
      "value": "$color.bg.canvas"
    },
    "page.bg.surface": {
      "type": "color",
      "value": "$color.bg.surface"
    },
    "page.border": {
      "type": "color",
      "value": "$color.border.subtle"
    },
    "page.font": {
      "type": "string",
      "value": "Inter"
    },
    "page.radius": {
      "type": "number",
      "value": "$space.3"
    },
    "page.space": {
      "type": "number",
      "value": "$space.4"
    },
    "page.space.relaxed": {
      "type": "number",
      "value": "$space.6"
    },
    "page.space.tight": {
      "type": "number",
      "value": "$space.2"
    },
    "page.text": {
      "type": "color",
      "value": "$color.text.primary"
    },
    "page.text.link": {
      "type": "color",
      "value": "$color.primary"
    },
    "page.text.muted": {
      "type": "color",
      "value": "$color.text.muted"
    },
    "page.text.success": {
      "type": "color",
      "value": "#16A34A"
    }
  }
}