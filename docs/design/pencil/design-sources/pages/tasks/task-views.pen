                  "name": "text/list",
                  "fill": "#0F172A",
                  "content": "list / columns / rows",
                  "fontFamily": "\\$page.font",
                  "fontSize": 13,
                  "fontWeight": "500"
                },
                {
                  "id": "aQmuI",
