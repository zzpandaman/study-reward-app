{
  "version": "2.10",
  "children": [
    {
      "type": "frame",
      "id": "page_task_views",
      "x": 0,
      "y": 0,
      "name": "Task Views",
      "width": 1280,
      "height": 800,
      "fill": "#FFFFFF",
      "layout": "vertical",
      "gap": "\\$page.space",
      "padding": "$space.6",
      "children": [
        {
          "type": "text",
          "id": "title_task_views",
          "fill": "#0F172A",
          "content": "任务管理视图",
          "fontFamily": "\\$page.font",
          "fontSize": 28,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "desc_task_views",
          "fill": "#0F172A",
          "content": "覆盖控制台与模板页：展示进行中任务、待办池与模板入口。",
          "fontFamily": "\\$page.font",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "UHtnk",
          "name": "header/tasks",
          "width": "fill_container",
          "fill": "#FFFFFF",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "#E2E8F0"
          },
          "padding": [
            "$space.3",
            "$space.4"
          ],
          "children": [
            {
              "type": "text",
              "id": "X6tHv",
              "name": "text/header",
              "fill": "#0F172A",
              "content": "今日任务概览 / 快捷过滤 / 批量操作",
              "fontFamily": "\\$page.font",
              "fontSize": 14,
              "fontWeight": "600"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ZbFVf",
          "name": "content/tasks-main",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "#FFFFFF",
          "gap": "\\$page.space.tight",
          "padding": "$space.3",
          "children": [
            {
              "type": "frame",
              "id": "8jNwx",
              "name": "list/task-list",
