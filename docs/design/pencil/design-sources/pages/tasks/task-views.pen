                  "fill": "#FFFFFF",
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#E2E8F0"
                  },
                  "descendants": {
                    "O1GTG": {
                      "fontFamily": "\\$page.font",
                      "fill": "#0F172A"
                    },
                    "1TUp0": {
                      "fontFamily": "\\$page.font",
                      "fill": "#0F172A"
                    }
                  }
                }
              ]
            },
            {
              "type": "frame",
              "id": "Ly2c0",
              "name": "detail/task-detail",
              "width": "fill_container",
