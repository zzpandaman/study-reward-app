                  "fill": "#FFFFFF",
                  "gap": "\\$page.space.tight",
                  "stroke": {
                    "align": "inside",
                    "thickness": 1,
                    "fill": "#E2E8F0"
                  },
                  "descendants": {
                    "CZKlZ": {
                      "fontFamily": "\\$page.font",
                      "fill": "#0F172A"
                    },
                    "c5q9U": {
                      "fontFamily": "\\$page.font",
                      "fill": "#0F172A"
                    }
                  }
                },
                {
                  "id": "QsUR3",
