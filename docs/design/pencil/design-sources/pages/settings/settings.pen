{
  "version": "2.10",
  "children": [
    {
      "type": "frame",
      "id": "page_settings",
      "x": 0,
      "y": 0,
      "name": "Settings",
      "width": 1280,
      "height": 800,
      "fill": "$color.bg.canvas",
      "layout": "vertical",
      "gap": "$space.4",
      "padding": "$space.6",
      "alignItems": "center",
      "children": [
        {
          "type": "text",
          "id": "title_settings",
          "fill": "$color.text.primary",
          "textGrowth": "fixed-width",
          "width": 1200,
          "content": "/settings -> src/pages/SettingsPage.tsx",
          "fontFamily": "Inter",
          "fontSize": 24,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "desc_settings",
          "fill": "$color.text.muted",
          "textGrowth": "fixed-width",
          "width": 1200,
          "content": "主题、账户、计时、偏好四组设置与配对区块。",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "06tQy",
          "name": "header/settings",
          "width": 1200,
          "fill": "$color.bg.surface",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$color.border.subtle"
          },
          "padding": [
            "$space.3",
            "$space.4"
          ],
          "children": [
            {
              "type": "text",
              "id": "NKPma",
              "name": "text/header",
              "fill": "#334155",
              "content": "设置中心：账户、主题、偏好与配对",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "0oZ3w",
          "name": "content/settings-main",
          "width": 1200,
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$color.border.subtle"
          },
          "gap": "$space.3",
          "padding": "$space.3",
          "children": [
            {
              "type": "frame",
              "id": "W9JVE",
              "name": "sidebar/settings-menu",
              "width": 260,
              "height": "fill_container",
              "fill": "\\$color.bg.surface",
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "#F1F5F9"
              },
              "layout": "vertical",
              "children": [
                {
                  "id": "vYWwy",
                  "type": "ref",
                  "ref": "Z8Q2n",
                  "width": "fill_container",
                  "name": "setItemUseC1",
                  "descendants": {
                    "qZDkd": {
                      "content": "常规设置"
                    },
                    "Fu44q": {
                      "content": "主题与显示"
                    }
                  }
                },
                {
                  "id": "O4Jyn",
                  "type": "ref",
                  "ref": "Z8Q2n",
                  "width": "fill_container",
                  "name": "setItemUseC2",
                  "descendants": {
                    "qZDkd": {
                      "content": "计时设置"
                    },
                    "Fu44q": {
                      "content": "番茄钟与休息策略"
                    }
                  }
                }
              ]
            },
            {
              "type": "frame",
              "id": "vQ43r",
              "name": "form/settings-content",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "\\$color.bg.surface",
              "stroke": {
                "align": "inside",
                "thickness": 1,
                "fill": "#F1F5F9"
              },
              "layout": "vertical",
              "children": [
                {
                  "id": "MfPoe",
                  "type": "ref",
                  "ref": "Z8Q2n",
                  "width": "fill_container",
                  "name": "setItemUseC3",
                  "descendants": {
                    "qZDkd": {
                      "content": "配对设置"
                    },
                    "Fu44q": {
                      "content": "设备绑定与同步状态"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "2elNp",
      "x": 0,
      "y": 840,
      "name": "components/showcase",
      "width": 360,
      "fill": "$color.bg.muted",
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "$color.border.subtle"
      },
      "layout": "vertical",
      "gap": "$space.3",
      "padding": "$space.4",
      "children": [
        {
          "type": "frame",
          "id": "Z8Q2n",
          "name": "component/settings-item",
          "reusable": true,
          "width": "fill_container",
          "height": 72,
          "fill": "\\$color.bg.surface",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$color.border.subtle"
          },
          "layout": "vertical",
          "padding": [
            12,
            14
          ],
          "children": [
            {
              "type": "text",
              "id": "qZDkd",
              "name": "setItemTextC",
              "fill": "\\$color.text.primary",
              "content": "General",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Fu44q",
              "name": "setHintC",
              "fill": "\\$color.text.primary",
              "content": "Config entry",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    }
  ],
  "variables": {
    "color.bg.canvas": {
      "type": "color",
      "value": "#F5F7FA"
    },
    "color.bg.muted": {
      "type": "color",
      "value": "#F1F5F9"
    },
    "color.bg.surface": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "color.border.soft": {
      "type": "color",
      "value": "#F1F5F9"
    },
    "color.border.subtle": {
      "type": "color",
      "value": "#E2E8F0"
    },
    "color.primary": {
      "type": "color",
      "value": "#2563EB"
    },
    "color.text.muted": {
      "type": "color",
      "value": "#64748B"
    },
    "color.text.primary": {
      "type": "color",
      "value": "#0F172A"
    },
    "space.1": {
      "type": "number",
      "value": 4
    },
    "space.2": {
      "type": "number",
      "value": 8
    },
    "space.3": {
      "type": "number",
      "value": 12
    },
    "space.4": {
      "type": "number",
      "value": 16
    },
    "space.6": {
      "type": "number",
      "value": 24
    }
  }
}