{
  "version": "2.10",
  "children": [
    {
      "type": "frame",
      "id": "page_shop",
      "x": 0,
      "y": 0,
      "name": "Shop",
      "width": 1280,
      "height": 800,
      "fill": "$color.bg.canvas",
      "layout": "vertical",
      "gap": "$space.4",
      "padding": "$space.6",
      "children": [
        {
          "type": "text",
          "id": "title_shop",
          "fill": "$color.text.primary",
          "content": "商品商城",
          "fontFamily": "Inter",
          "fontSize": 28,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "desc_shop",
          "fill": "$color.text.muted",
          "content": "支持积分兑换、库存状态与分类筛选，突出本期推荐商品。",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "mOsiI",
          "name": "header/shop",
          "width": "fill_container",
          "fill": "$color.bg.surface",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$color.border.subtle"
          },
          "padding": [
            "$space.3",
            "$space.4"
          ],
          "children": [
            {
              "type": "text",
              "id": "4rA84",
              "name": "text/header",
              "fill": "$color.primary",
              "content": "当前积分 1,280 / 快速搜索 / 新建商品",
              "fontFamily": "Inter",
              "fontSize": 14,
              "fontWeight": "600"
            }
          ]
        },
        {
          "type": "frame",
          "id": "OOlbW",
          "name": "filters/shop",
          "width": "fill_container",
          "fill": "$color.bg.surface",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$color.border.subtle"
          },
          "padding": [
            "$space.2",
            "$space.3"
          ],
          "children": [
            {
              "type": "text",
              "id": "wjP58",
              "name": "text/filters",
              "fill": "#1E293B",
              "content": "分类：学习用品 · 数码配件 · 生活服务",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "e1f1X",
          "name": "list/shop-items",
          "width": "fill_container",
          "height": "fill_container",
          "fill": "$color.bg.surface",
          "stroke": {
            "align": "inside",
            "thickness": 1,
            "fill": "$color.border.subtle"
          },
          "layout": "vertical",
          "gap": "$space.3",
          "padding": "$space.3",
          "children": [
            {
              "type": "text",
              "id": "KbjQ4",
              "name": "text/list",
              "fill": "#1F2937",
              "content": "item list / cards",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "500"
            },
            {
              "id": "pvlTd",
              "type": "ref",
              "ref": "gB6aC",
              "width": "fill_container",
              "name": "shopInstA"
            },
            {
              "id": "JibcK",
              "type": "ref",
              "ref": "gB6aC",
              "width": "fill_container",
              "name": "shopInstB"
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "gB6aC",
