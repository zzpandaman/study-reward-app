        {
          "type": "text",
          "id": "ZDmlP",
          "name": "shopMeta",
          "fill": "$color.primary",
          "content": "所需积分：599 · 库存：24",
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
