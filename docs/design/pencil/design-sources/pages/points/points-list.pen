{
  "version": "2.10",
  "children": [
    {
      "type": "frame",
      "id": "page_points_list",
      "x": 0,
      "y": 0,
      "name": "Points List",
      "width": 1280,
      "height": 800,
      "fill": "$color.bg.canvas",
